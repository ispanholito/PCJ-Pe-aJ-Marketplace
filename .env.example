# Nomes das variáveis de ambiente do PeçaJá — SEM valores reais (PGC 4.1).
# Copie para .env para uso local. No pipeline, os valores ficam no GitHub
# Secrets / Variables do Environment correspondente.

# URL da API de catálogo (vazio = catálogo de demonstração local)
API_URL=

# Chave pública do serviço de backend (quando adotado — ver docs/adr)
BACKEND_ANON_KEY=

# Token do UptimeRobot usado só para consultar o status (opcional)
UPTIMEROBOT_API_KEY=
